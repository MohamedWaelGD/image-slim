{
  "name": "@mohamedwaelgd/image-slim",
  "version": "0.3.0",
  "description": "Framework-agnostic browser image resizing and compression.",
  "keywords": [
    "image",
    "optimizer",
    "compression",
    "resize",
    "browser",
    "typescript"
  ],
  "license": "MIT",
  "author": "Mohamed Wael",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohamedWaelGD/image-slim.git"
  },
  "bugs": {
    "url": "https://github.com/MohamedWaelGD/image-slim/issues"
  },
  "homepage": "https://github.com/MohamedWaelGD/image-slim#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && playwright test",
    "test:stress": "npm run build && playwright test --config playwright.stress.config.ts",
    "benchmark": "npm run build && playwright test --config playwright.benchmark.config.ts",
    "test:integrations": "node scripts/run-consumer-builds.mjs",
    "validate:package": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && publint && npm pack --dry-run",
    "prepublishOnly": "npm run validate:package"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "playwright": "^1.49.1",
    "prettier": "^3.4.2",
    "publint": "^0.3.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
